# ============================================================ Kernel source ==
KERNEL_SOURCE=https://github.com/Akitlove/android_kernel_xiaomi_sm7250
KERNEL_SOURCE_BRANCH=16-susfs-bak2
KERNEL_CONFIG=vendor/lito-perf_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64
KERNEL_NAME=picasso
ADD_LOCALVERSION_TO_FILENAME=true

EXTRA_CMDS=LD=ld.lld
CUSTOM_CMDS=CLANG_TRIPLE=aarch64-linux-gnu-

# =================================================================== Clang ==
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_CUSTOM_CLANG=false
USE_LLVM=false

# ===================================================================== GCC ==
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true

# =============================================================== KernelSU ==
# 重要：作者已内置 ReSukiSU，这里设 none 不重复集成
KSU_VARIANT=none
KSU_REF=
KSU_HOOK_MODE=auto

# =================================================================== SUSFS ==
# 作者内核已内置 SUSFS（CONFIG_KSU_SUSFS=y），不需要模板再打
ENABLE_SUSFS=false

# ========================================================== Extra patches ==
# 4.19 内核必须开 path_umount 回移
ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ================================================================ Kconfig ===
# 作者已内置 KSU，不需要模板再加 kprobes
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=true

# picasso 设备专用配置（来自作者的 vendor/xiaomi/picasso.config）
EXTRA_DEFCONFIG="CONFIG_FRAME_WARN=4096 CONFIG_TOUCHSCREEN_NT36xxx_HOSTDL_SPI=y CONFIG_TOUCHSCREEN_NVT_DEBUG_FS=y CONFIG_INPUT_FINGERPRINT=y CONFIG_FINGERPRINT_GOODIX_TA=y CONFIG_FINGERPRINT_FPC_TEE=y CONFIG_FINGERPRINT_FP_VREG_CONTROL=y CONFIG_BQ2597X_CHARGE_PUMP=y CONFIG_BATT_VERIFY_BY_DS28E16=y CONFIG_ONEWIRE_GPIO=y CONFIG_MI7250_CAMERA=y CONFIG_IR_SPI=y CONFIG_LIRC=y CONFIG_RC_CORE=y CONFIG_RC_DECODERS=y CONFIG_RC_DEVICES=y CONFIG_EROFS_FS=y CONFIG_RMNET_PERF=y CONFIG_RMNET_SHS=y CONFIG_QCA_CLD_WLAN=y CONFIG_LOG_BUF_SHIFT=21 CONFIG_USB_CONFIGFS_RNDIS=y CONFIG_G7A_CHG=y CONFIG_BOARD_XIAOMI=y CONFIG_BOARD_XIAOMI_SM7250=y CONFIG_BOARD_PICASSO=y CONFIG_KSU=y CONFIG_KSU_SUSFS=y"

# ============================================================= AnyKernel3 ===
USE_CUSTOM_ANYKERNEL3=false

# ============================================================== Packaging ===
NEED_DTBO=false
BUILD_BOOT_IMG=false

# ================================================================= Runner ===
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
