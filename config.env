# ====================内核源，填你fork后的内核仓库====================
KERNEL_SOURCE=https://github.com/wkx2009/android_kernel_xiaomi_sm7250
KERNEL_SOURCE_BRANCH=16-susfs-bak2
KERNEL_CONFIG=vendor/lito-perf_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64
KERNEL_NAME=picasso
ADD_LOCALVERSION_TO_FILENAME=true

EXTRA_CMDS=LD=ld.lld
CUSTOM_CMDS=CLANG_TRIPLE=aarch64-linux-gnu-

# ====================工具链 4.19固定r450784e====================
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_CUSTOM_CLANG=false
USE_LLVM=false
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true

# ====================ROOT：选用 sukisu‑ultra，脚本外部打补丁====================
KSU_VARIANT=sukisu-ultra
KSU_REF=builtin
# 4.19非GKI内核，强制手动hook，kprobes容易翻车
KSU_HOOK_MODE=manual

# 脚本集成sukisu‑ultra内置自带SUSFS，模板侧关闭susfs补丁
ENABLE_SUSFS=false
# 4.19内核必须开启path_umount回移，模块卸载正常
ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=false
ENABLE_KPM=true

# =====================Kconfig注入====================
ADD_KPROBES_CONFIG=true
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=true

# picasso设备硬件配置，从原作者picasso.config复制，【删掉CONFIG_KSU、CONFIG_KSU_SUSFS】
EXTRA_DEFCONFIG="CONFIG_FRAME_WARN=4096 CONFIG_TOUCHSCREEN_NT36xxx_HOSTDL_SPI=y CONFIG_TOUCHSCREEN_NVT_DEBUG_FS=y CONFIG_INPUT_FINGERPRINT=y CONFIG_FINGERPRINT_GOODIX_TA=y CONFIG_FINGERPRINT_FPC_TEE=y CONFIG_FINGERPRINT_FP_VREG_CONTROL=y CONFIG_BQ2597X_CHARGE_PUMP=y CONFIG_BATT_VERIFY_BY_DS28E16=y CONFIG_ONEWIRE_GPIO=y CONFIG_MI7250_CAMERA=y CONFIG_IR_SPI=y CONFIG_LIRC=y CONFIG_RC_CORE=y CONFIG_RC_DECODERS=y CONFIG_RC_DEVICES=y CONFIG_EROFS_FS=y CONFIG_RMNET_PERF=y CONFIG_RMNET_SHS=y CONFIG_QCA_CLD_WLAN=y CONFIG_LOG_BUF_SHIFT=21 CONFIG_USB_CONFIGFS_RNDIS=y CONFIG_G7A_CHG=y CONFIG_BOARD_XIAOMI=y CONFIG_BOARD_XIAOMI_SM7250=y CONFIG_BOARD_PICASSO=y"

# =====================打包====================
USE_CUSTOM_ANYKERNEL3=false
NEED_DTBO=false
BUILD_BOOT_IMG=false

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
