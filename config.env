# ============================================================
# KernelSU Action - Redmi K30 5G / Picasso
# Android 16 / RisingOS / Linux 4.19 Non-GKI
# ============================================================


# ============================================================
# Kernel source
# ============================================================

KERNEL_SOURCE=https://github.com/Akitlove/android_kernel_xiaomi_sm7250

KERNEL_SOURCE_BRANCH=16-susfs-bak2

KERNEL_CONFIG=vendor/lito-perf_defconfig

KERNEL_IMAGE_NAME=Image.gz-dtb

ARCH=arm64

# Device name used for artifact name / CONFIG_LOCALVERSION
KERNEL_NAME=picasso

ADD_LOCALVERSION_TO_FILENAME=false


# ============================================================
# Extra make commands
# ============================================================

# 4.19 vendor drivers may trigger warnings with newer Clang.
# Do not make strict-prototypes warnings fatal.

EXTRA_CMDS:LD=ld.lld KCFLAGS=-Wno-error=strict-prototypes

CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-


# ============================================================
# Clang
# ============================================================

# For Linux 4.19, use the known-compatible old AOSP Clang.

CLANG_BRANCH=master-kernel-build-2022

CLANG_VERSION=r450784e

USE_CUSTOM_CLANG=false

CUSTOM_CLANG_SOURCE=

CUSTOM_CLANG_BRANCH=


# ============================================================
# LLVM
# ============================================================

# Do NOT force LLVM=1 / LLVM_IAS=1 on this old 4.19 tree.

USE_LLVM=false


# ============================================================
# GCC
# ============================================================

# Keep both GCC toolchains available for the old vendor kernel.

ENABLE_GCC_ARM64=true

ENABLE_GCC_ARM32=true

USE_CUSTOM_GCC_64=false

CUSTOM_GCC_64_SOURCE=

CUSTOM_GCC_64_BRANCH=

CUSTOM_GCC_64_BIN=aarch64-linux-android-

USE_CUSTOM_GCC_32=false

CUSTOM_GCC_32_SOURCE=

CUSTOM_GCC_32_BRANCH=

CUSTOM_GCC_32_BIN=arm-linux-androideabi-


# ============================================================
# KernelSU / SukiSU
# ============================================================

# SukiSU-Ultra
#
# "builtin" is the source-integrated variant.
# It is also the SukiSU-Ultra variant that ships SUSFS itself.

KSU_VARIANT=sukisu-ultra

KSU_REF=builtin


# Linux 4.19 Non-GKI:
# use manual hooks instead of kprobes.

KSU_HOOK_MODE=manual


# Leave manager signature checks empty.
# Use the official manager.

KSU_EXPECTED_SIZE=

KSU_EXPECTED_HASH=


# ============================================================
# SUSFS
# ============================================================

# IMPORTANT:
#
# SukiSU-Ultra builtin already contains SUSFS support.
# Therefore we do NOT apply the external susfs4ksu patch.

ENABLE_SUSFS=false

SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git

SUSFS_BRANCH=auto


# ============================================================
# Extra patches
# ============================================================

# Linux 4.19 is older than 5.9.
# KernelSU may need path_umount() backported.

ENABLE_PATH_UMOUNT=false


# Do not add additional fingerprint/hide patches yet.

ENABLE_HIDE_STUFF=false


# Do NOT enable SukiSU KPM on the first test build.

ENABLE_KPM=false


# ============================================================
# Kconfig
# ============================================================

# Do not automatically enable KPROBES.
# We are deliberately using manual hooks.

ADD_KPROBES_CONFIG=false


# Leave OverlayFS automatic support enabled.
# The Action uses this for KernelSU module mounting/system RW.

ADD_OVERLAYFS_CONFIG=true


# Keep the kernel's original LTO configuration.

DISABLE_LTO=false


# Old vendor kernel + modern Clang:
# prevent compiler warnings from becoming fatal.

DISABLE_CC_WERROR=true


# Do not inject random KSU configs manually.
# SukiSU setup script will handle its own Kconfig.

EXTRA_DEFCONFIG=


# ============================================================
# AnyKernel3
# ============================================================

USE_CUSTOM_ANYKERNEL3=false

CUSTOM_ANYKERNEL3_SOURCE=

CUSTOM_ANYKERNEL3_BRANCH=


# ============================================================
# DTBO
# ============================================================

NEED_DTBO=false


# ============================================================
# Boot image
# ============================================================

# Do not build/repack boot.img yet.
# First produce an AnyKernel3 package.

BUILD_BOOT_IMG=false

SOURCE_BOOT_IMAGE=


# ============================================================
# GitHub Actions runner
# ============================================================

ENABLE_CCACHE=true

REMOVE_UNUSED_PACKAGES=true
